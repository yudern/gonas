#!/bin/sh
# gonas-console 是「開機就是 GoNAS」這個外觀體驗的核心:appliance 版
# 映像檔啟動之後,tty1(接實體螢幕鍵盤、或虛擬機主控台視窗看到的那個
# 畫面)不是一般 Debian 的登入提示,而是這支腳本產生的精簡狀態畫面——
# 版本、目前的網路位址、要用瀏覽器連到哪個網址,參考的是 Unraid/TrueNAS
# 這類家用 NAS 系統「開機看到的是產品名稱跟連線資訊,不是一般 Linux
# distro 的登入畫面」的體驗慣例。
#
# 刻意寫成 POSIX /bin/sh 而不是 bash 腳本或另外寫一個 Go 小工具:這台
# 螢幕只需要每隔幾秒重新整理一次文字內容,shell + 標準工具
# (hostname/ip/cat)完全夠用,不需要多引入一個編譯目標或額外的執行檔
# 相依性——appliance 映像檔本身已經夠複雜,這裡刻意保持最簡單的做法。
#
# 這支腳本本身不提供任何互動選單(這是使用者在澄清問題裡選的「精簡
# 狀態畫面」路線,不是「簡易文字選單」路線)——所有真正的設定都在
# Web 介面做,這個畫面純粹是「開機之後我要怎麼連上去」的指標。真的
# 需要在機器上開一個 shell 除錯時,標準的 Ctrl+Alt+F2(或對虛擬機/
# 遠端管理卡是切換到 tty2)一樣能拿到一個正常的登入畫面——只有 tty1
# 被 late-command.sh 停用/遮罩掉 getty@tty1.service、換成
# gonas-console.service(見該檔案的 Conflicts=getty@tty1.service),
# tty2 以後維持系統原本的 getty 登入,不影響「找一台真的機器除錯」
# 這個管道。

VERSION_FILE=/etc/gonas-release
GONAS_ENV_FILE=/etc/gonas/gonas.env

get_version() {
    if command -v gonasd >/dev/null 2>&1; then
        gonasd -version 2>/dev/null | awk '{print $2}'
    else
        echo "unknown"
    fi
}

get_listen_addr() {
    # 跟 install.sh/gonas.service 用同一份 env 檔案讀 GONAS_LISTEN_ADDR,
    # 沒設定就是 gonasd 本身的預設值 :8291(見 internal/config），這裡
    # 只是單純把設定值顯示出來，不重新定義一份預設值的判斷邏輯。
    addr=":8291"
    if [ -r "$GONAS_ENV_FILE" ]; then
        val=$(grep -E '^GONAS_LISTEN_ADDR=' "$GONAS_ENV_FILE" 2>/dev/null | tail -n1 | cut -d= -f2-)
        [ -n "$val" ] && addr="$val"
    fi
    echo "$addr"
}

get_port() {
    addr="$1"
    case "$addr" in
        *:*) echo "${addr##*:}" ;;
        *) echo "8291" ;;
    esac
}

list_ipv4_addrs() {
    # 只列出「看起來像真的區網位址」的介面(排除 lo 本身跟還沒 up 的
    # 介面)——ip -4 -o addr 是 iproute2 的標準輸出格式，Debian 最小化
    # 安裝就會有這個套件(是很多其他基礎功能的相依套件），不需要額外
    # 安裝東西才能顯示網路資訊。
    if command -v ip >/dev/null 2>&1; then
        ip -4 -o addr show up scope global 2>/dev/null | awk '{print $2, $4}' | cut -d/ -f1 | sed 's/ /  IP: /'
    fi
}

render() {
    version=$(get_version)
    addr=$(get_listen_addr)
    port=$(get_port "$addr")
    hostname_val=$(hostname 2>/dev/null || echo gonas)
    now=$(date '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null)

    clear
    echo ""
    echo "  ██████╗  ██████╗ ███╗   ██╗ █████╗ ███████╗"
    echo " ██╔════╝ ██╔═══██╗████╗  ██║██╔══██╗██╔════╝"
    echo " ██║  ███╗██║   ██║██╔██╗ ██║███████║███████╗"
    echo " ██║   ██║██║   ██║██║╚██╗██║██╔══██║╚════██║"
    echo " ╚██████╔╝╚██████╔╝██║ ╚████║██║  ██║███████║"
    echo "  ╚═════╝  ╚═════╝ ╚═╝  ╚═══╝╚═╝  ╚═╝╚══════╝"
    echo ""
    echo "  版本 Version: ${version}          主機名稱 Host: ${hostname_val}"
    echo "  ------------------------------------------------------------"
    echo "  請用瀏覽器連到下面的網址開始設定 GoNAS:"
    echo "  Open one of these addresses in a browser to set up GoNAS:"
    echo ""
    have_addr=0
    for ip in $(list_ipv4_addrs | sed 's/^.*IP: //'); do
        have_addr=1
        echo "      http://${ip}:${port}"
    done
    if [ "$have_addr" -eq 0 ]; then
        echo "      (尚未偵測到網路連線 / no network connection detected yet)"
    fi
    echo ""
    echo "  ------------------------------------------------------------"
    echo "  這個畫面只顯示連線資訊，所有設定請在網頁介面完成。"
    echo "  This screen is informational only — all setup happens in the web UI."
    echo "  需要指令列存取，請切換到 tty2(Ctrl+Alt+F2)。"
    echo "  For command-line access, switch to tty2 (Ctrl+Alt+F2)."
    echo ""
    echo "  ${now}"
}

# 每 5 秒重新整理一次——夠即時反映開機後才拿到 DHCP 位址這種情況，又
# 不會像更短的間隔那樣沒有必要地一直重繪整個畫面。這支程序本身是
# gonas-console.service 的 ExecStart，systemd 已經處理了「終端機關掉/
# 這支程序結束時該怎麼辦」（Restart=always，見該 unit 檔），所以這裡
# 單純寫一個無窮迴圈就好，不需要自己處理訊號或背景化。
while true; do
    render
    sleep 5
done
