#!/bin/sh
# gonas-console 是「開機就是 GoNAS」這個外觀體驗的核心:appliance 版
# 映像檔啟動之後,tty1(接實體螢幕鍵盤、或虛擬機主控台視窗看到的那個
# 畫面)不是一般 Debian 的登入提示,而是這支腳本產生的精簡狀態畫面——
# 版本、目前的網路位址、要用瀏覽器連到哪個網址,參考的是 Unraid/TrueNAS
# 這類家用 NAS 系統「開機看到的是產品名稱跟連線資訊,不是一般 Linux
# distro 的登入畫面」的體驗慣例。
#
# 刻意寫成 POSIX /bin/sh 而不是 bash 腳本或另外寫一個 Go 小工具:這台
# 螢幕只需要每隔幾秒重新整理一次文字內容,shell + 標準工具
# (hostname/ip/cat)完全夠用,不需要多引入一個編譯目標或額外的執行檔
# 相依性——appliance 映像檔本身已經夠複雜,這裡刻意保持最簡單的做法。
#
# 這支腳本本身不提供任何互動選單(這是使用者在澄清問題裡選的「精簡
# 狀態畫面」路線,不是「簡易文字選單」路線)——所有真正的設定都在
# Web 介面做,這個畫面純粹是「開機之後我要怎麼連上去」的指標。真的
# 需要在機器上開一個 shell 除錯時,標準的 Ctrl+Alt+F2(或對虛擬機/
# 遠端管理卡是切換到 tty2)一樣能拿到一個正常的登入畫面——只有 tty1
# 被 late-command.sh 停用/遮罩掉 getty@tty1.service、換成
# gonas-console.service(見該檔案的 Conflicts=getty@tty1.service),
# tty2 以後維持系統原本的 getty 登入,不影響「找一台真的機器除錯」
# 這個管道。

VERSION_FILE=/etc/gonas-release
GONAS_ENV_FILE=/etc/gonas/gonas.env

get_version() {
    if command -v gonasd >/dev/null 2>&1; then
        gonasd -version 2>/dev/null | awk '{print $2}'
    else
        echo "unknown"
    fi
}

get_listen_addr() {
    # 跟 install.sh/gonas.service 用同一份 env 檔案讀 GONAS_LISTEN_ADDR,
    # 沒設定就是 gonasd 本身的預設值 :8291(見 internal/config），這裡
    # 只是單純把設定值顯示出來，不重新定義一份預設值的判斷邏輯。
    addr=":8291"
    if [ -r "$GONAS_ENV_FILE" ]; then
        val=$(grep -E '^GONAS_LISTEN_ADDR=' "$GONAS_ENV_FILE" 2>/dev/null | tail -n1 | cut -d= -f2-)
        [ -n "$val" ] && addr="$val"
    fi
    echo "$addr"
}

get_port() {
    addr="$1"
    case "$addr" in
        *:*) echo "${addr##*:}" ;;
        *) echo "8291" ;;
    esac
}

list_ipv4_addrs() {
    # 只列出「看起來像真的區網位址」的介面(排除 lo 本身跟還沒 up 的
    # 介面)——ip -4 -o addr 是 iproute2 的標準輸出格式，Debian 最小化
    # 安裝就會有這個套件(是很多其他基礎功能的相依套件），不需要額外
    # 安裝東西才能顯示網路資訊。
    if command -v ip >/dev/null 2>&1; then
        ip -4 -o addr show up scope global 2>/dev/null | awk '{print $2, $4}' | cut -d/ -f1 | sed 's/ /  IP: /'
    fi
}

# get_service_state 回傳 gonas.service 目前的 systemd 狀態字串
# (active/activating/failed/inactive...)。這是第二十六輪新增的:
# 原本這個畫面只會讀網路介面、印出一個 http://IP:port 的網址,完全
# 不管 gonasd 這個服務到底有沒有真的在跑——結果是「服務其實沒起來」
# 跟「服務好好在跑」兩種情況畫面長得一模一樣,使用者照著畫面上的網址
# 連卻打不開,卻無從得知是哪一層出問題(這正是使用者實測 amd64+ESXi
# 遇到的「IP 加端口打不開頁面」那個回報的根源:畫面給了一種「一切正常」
# 的假象)。用 `systemctl is-active` 直接問 systemd,這是最可靠、且
# 一定裝得到的來源(systemd 本身就是 PID 1)。
get_service_state() {
    if command -v systemctl >/dev/null 2>&1; then
        systemctl is-active gonas.service 2>/dev/null || true
    else
        echo "unknown"
    fi
}

# port_is_listening 檢查 gonasd 是不是真的有在監聽它的埠——服務「狀態
# active」但「沒真的 bind 上埠」是有可能的(例如埠被占用、剛啟動還沒
# 綁定完成),多這一層檢查能把「服務在跑」跟「網頁真的連得上」分清楚。
# ss 由 iproute2 提供(跟上面的 ip 同一個套件,Debian 最小安裝一定有)。
port_is_listening() {
    _pil_port="$1"
    if command -v ss >/dev/null 2>&1; then
        # 不用 -H(某些較舊的 ss 不支援)——標題列的 "Local Address:Port"
        # 結尾是 "Port" 這個字、不是數字,不會誤中下面這個「冒號/點 + 埠號
        # 結尾」的比對,所以留著標題列也不影響判斷。
        ss -tln 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]${_pil_port}\$"
        return $?
    fi
    # 沒有 ss 就無法判斷,回傳「不確定」(用退出碼 2 跟明確的「沒在聽」
    # 區分開),呼叫端會據此不顯示這一層的判斷,而不是誤報成故障。
    return 2
}

# ssh_installed 判斷這台機器到底有沒有裝好 SSH server——第二十七輪新增:
# 使用者實測回報「IP 通,但 SSH 連不上」。SSH 是離線打包(build-iso.sh
# 4.5 節在建置機器上抓 openssh-server 的 .deb)+ late-command.sh 1.7 節
# 離線 dpkg -i 裝上去的,整條路是刻意的 best-effort(抓不到/裝不起來
# 只記警告不中止),所以「SSH 到底有沒有真的裝成功」是一件使用者原本
# 完全看不到、只能靠實際去連才會發現的事。用 sshd 這個執行檔存不存在
# 判斷「有沒有裝」最可靠(openssh-server 一定會把它放在 /usr/sbin/sshd),
# 不靠 systemd unit 名稱(ssh.service / sshd.service 兩種都可能)。
ssh_installed() {
    [ -x /usr/sbin/sshd ] || command -v sshd >/dev/null 2>&1
}

# get_ssh_state 回傳 SSH 服務的 systemd 狀態。Debian 的 openssh-server
# 主要 unit 叫 ssh.service(sshd.service 是別名),兩個都問一下,拿第一個
# 問得到有效狀態的。
get_ssh_state() {
    if command -v systemctl >/dev/null 2>&1; then
        _gss=$(systemctl is-active ssh.service 2>/dev/null || true)
        if [ "$_gss" = "active" ]; then echo active; return; fi
        _gss2=$(systemctl is-active sshd.service 2>/dev/null || true)
        if [ "$_gss2" = "active" ]; then echo active; return; fi
        # 都不是 active——回報 ssh.service 的狀態當代表(inactive/failed 等)
        echo "${_gss:-unknown}"
    else
        echo "unknown"
    fi
}

render() {
    version=$(get_version)
    addr=$(get_listen_addr)
    port=$(get_port "$addr")
    hostname_val=$(hostname 2>/dev/null || echo gonas)
    now=$(date '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null)
    svc_state=$(get_service_state)

    clear
    echo ""
    echo "  ██████╗  ██████╗ ███╗   ██╗ █████╗ ███████╗"
    echo " ██╔════╝ ██╔═══██╗████╗  ██║██╔══██╗██╔════╝"
    echo " ██║  ███╗██║   ██║██╔██╗ ██║███████║███████╗"
    echo " ██║   ██║██║   ██║██║╚██╗██║██╔══██║╚════██║"
    echo " ╚██████╔╝╚██████╔╝██║ ╚████║██║  ██║███████║"
    echo "  ╚═════╝  ╚═════╝ ╚═╝  ╚═══╝╚═╝  ╚═╝╚══════╝"
    echo ""
    echo "  版本 Version: ${version}          主機名稱 Host: ${hostname_val}"
    echo "  ------------------------------------------------------------"

    # --- 服務健康狀態 ------------------------------------------------
    # 先把 gonasd 服務的狀態明確秀出來,而不是直接印網址讓使用者以為
    # 一切正常。三種情況分開處理,每一種都直接告訴使用者「網頁能不能連」
    # 以及「不能的話下一步該做什麼」。
    if [ "$svc_state" = "active" ]; then
        # 服務在跑,再確認埠真的綁上了(把「服務活著」跟「網頁連得上」
        # 分清楚)。port_is_listening 回傳:0=有在聽,1=沒在聽,2=無法判斷。
        if port_is_listening "$port"; then
            echo "  GoNAS 服務 Service: ● 運作中 running(正在監聽埠 port ${port})"
        else
            _pil_rc=$?
            if [ "$_pil_rc" = "1" ]; then
                echo "  GoNAS 服務 Service: ⚠ 已啟動但尚未監聽埠 ${port} running but not yet listening"
                echo "     (剛開機時可能需要幾秒;若持續如此,請見下方疑難排解)"
            else
                # 無法判斷(沒有 ss),就只報 systemd 的狀態,不誤報故障。
                echo "  GoNAS 服務 Service: ● 運作中 running"
            fi
        fi
        echo "  ------------------------------------------------------------"
        echo "  請用瀏覽器連到下面的網址開始設定 GoNAS:"
        echo "  Open one of these addresses in a browser to set up GoNAS:"
        echo ""
        have_addr=0
        for ip in $(list_ipv4_addrs | sed 's/^.*IP: //'); do
            have_addr=1
            echo "      http://${ip}:${port}"
        done
        if [ "$have_addr" -eq 0 ]; then
            echo "      (尚未偵測到網路連線 / no network detected yet — 網卡或"
            echo "       DHCP 可能還沒就緒;畫面每 5 秒自動更新)"
        fi
    else
        # 服務沒在跑——這就是「IP 加端口打不開頁面」最直接的原因。明確
        # 標紅字級的警告,並給出不需要猜測的下一步:切到 tty2 看服務狀態。
        echo "  GoNAS 服務 Service: ✗ 尚未運作 NOT running(狀態 state: ${svc_state:-unknown})"
        echo "  ------------------------------------------------------------"
        echo "  ⚠ 網頁介面現在會連不上(這就是頁面打不開的原因)。"
        echo "  ⚠ The web UI is NOT reachable yet — this is why the page won't open."
        echo ""
        if [ "$svc_state" = "activating" ]; then
            echo "  服務正在啟動中,請稍候幾秒,畫面每 5 秒會自動更新。"
            echo "  The service is still starting up; this screen refreshes every 5s."
        else
            echo "  請切換到 tty2(Ctrl+Alt+F2)、用 gonas 帳號登入後執行:"
            echo "  Switch to tty2 (Ctrl+Alt+F2), log in as 'gonas', then run:"
            echo ""
            echo "      sudo systemctl status gonas.service"
            echo "      sudo journalctl -u gonas -n 50 --no-pager"
            echo ""
            echo "  這兩行會顯示服務為什麼沒起來。"
            echo "  Those show why the service did not start."
        fi
    fi

    # --- SSH 狀態(遠端管理用的緊急備援管道) -------------------------
    # 使用者實測回報「IP 通但 SSH 連不上」——這一段把 SSH 到底裝了沒、
    # 有沒有在跑、port 22 有沒有在聽,直接秀在畫面上,不用使用者自己去猜。
    echo ""
    if ssh_installed; then
        ssh_state=$(get_ssh_state)
        if [ "$ssh_state" = "active" ] && port_is_listening 22; then
            echo "  SSH:  ● 可用 available(帳號 user: gonas,port 22)"
        elif [ "$ssh_state" = "active" ]; then
            echo "  SSH:  ● 服務運作中 running(port 22 尚未就緒或無法確認)"
        else
            echo "  SSH:  ✗ 已安裝但未運作 installed but not running(狀態 state: ${ssh_state})"
            echo "        切到 tty2 執行 sudo systemctl status ssh 看原因。"
        fi
    else
        echo "  SSH:  — 未安裝 not installed"
        echo "        (建置時的離線打包未成功;開機且有網路後可用"
        echo "         sudo apt install openssh-server 補裝)"
    fi

    echo ""
    echo "  ------------------------------------------------------------"
    echo "  這個畫面只顯示狀態,所有設定請在網頁介面完成。"
    echo "  This screen is informational only — all setup happens in the web UI."
    echo "  需要指令列存取,請切換到 tty2(Ctrl+Alt+F2)。"
    echo "  For command-line access, switch to tty2 (Ctrl+Alt+F2)."
    echo ""
    echo "  ${now}"
}

# 每 5 秒重新整理一次——夠即時反映開機後才拿到 DHCP 位址這種情況，又
# 不會像更短的間隔那樣沒有必要地一直重繪整個畫面。這支程序本身是
# gonas-console.service 的 ExecStart，systemd 已經處理了「終端機關掉/
# 這支程序結束時該怎麼辦」（Restart=always，見該 unit 檔），所以這裡
# 單純寫一個無窮迴圈就好，不需要自己處理訊號或背景化。
while true; do
    render
    sleep 5
done
