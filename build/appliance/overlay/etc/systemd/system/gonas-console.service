[Unit]
Description=GoNAS status console (tty1)
Documentation=https://github.com/bng147/gonas
# 這裡刻意「不」掛在 network-online.target 之後——原本的版本有,理由
# 是「這樣第一次畫面顯示時比較可能已經有網路位址可以秀」,但重新
# 覆閱時發現這個理由站不住腳,而且會實際傷害這個 Phase 最核心的目標:
# gonas.service 本身有 `Wants=network-online.target`(見
# build/systemd/gonas.service),現在已經確保會被 enable(見
# late-command.sh 修掉的那個 gonas.service 沒被 enable 的 bug),
# 代表 network-online.target 一定會被拉進每次開機的流程——如果這台
# 機器開機當下網路線還沒插好、DHCP 還沒生效、或接的是需要幾秒鐘做
# STP/協商的網管交換器(對實體 NAS 硬體來說完全不是罕見情境),
# `*-wait-online` 這類服務預設的逾時通常在數十秒等級,這段時間裡
# tty1 會完全是黑畫面(getty 已經被停用/遮罩,這支主控台又排在
# network-online.target 後面)——直接違背這整個 appliance 的核心賣點
# 「開機馬上看到 GoNAS 品牌畫面」。這支腳本本來就已經妥善處理「還沒
# 有網路位址」的情況(顯示提示文字,每 5 秒重新整理一次直到抓到位址
# 為止),完全不需要靠 systemd 排序去保證「畫面出現時網路一定已經
# 好了」這件事,拿掉這個排序限制只有好處(畫面出現得更快、更穩定),
# 沒有實質壞處。
After=systemd-user-sessions.service getty@tty1.service plymouth-quit-wait.service
After=rc-local.service
Conflicts=getty@tty1.service

[Service]
ExecStart=/usr/local/sbin/gonas-console
Restart=always
RestartSec=1
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
# 跟一般 getty 一樣用 tty1 本身當控制終端機，不需要另外配置 PAM/utmp
# 登入紀錄——這支程序不是一個登入 session，只是佔用 tty1 顯示畫面，
# 跟 plymouth 的開機動畫在同一個 tty 上顯示的方式類似。
KillMode=process
IgnoreSIGPIPE=no
SendSIGHUP=yes

[Install]
WantedBy=multi-user.target
