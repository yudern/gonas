[Unit]
Description=GoNAS core daemon
Documentation=https://github.com/bng147/gonas
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gonasd
Restart=on-failure
RestartSec=3s

# GoNAS 需要能操作硬碟裝置、掛載檔案系統、控制 Docker、寫 Samba 設定,
# 因此以 root 執行(這與 Unraid / OMV / TrueNAS 的作法一致)。
# Phase 6(網路與安全)會補上更細緻的能力限制(如 CAP_SYS_ADMIN 白名單)
# 而不是完全放棄 sandboxing。
User=root
Environment=GONAS_LISTEN_ADDR=:8291
Environment=GONAS_DATA_DIR=/var/lib/gonas
# install.sh 會建立 /etc/gonas/gonas.env(如果還不存在),裡面兩個變數的
# 註解掉的預設值。管理員要改監聽位址或資料目錄時,編輯那個檔案就好,
# 不用碰這個 unit file(避免 `dpkg`/未來套件更新或重新執行 install.sh 時
# 覆蓋掉手動修改)。前面加 "-" 表示檔案不存在時 systemd 不會報錯。
EnvironmentFile=-/etc/gonas/gonas.env

# 基本強化:仍允許裝置/掛載操作,但阻擋一些不必要的攻擊面。
NoNewPrivileges=true
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true

# Phase 9 補上的幾項:這些都只鎖「GoNAS 本身跟它會 fork/exec 出去的
# mergerfs/snapraid/smbd/rsync/wg 等子行程,反正都不需要用到」的能力,
# 不動到掛載/裝置存取這些核心功能,所以不需要真機也能確定不會弄壞
# 陣列/分享功能:
#   - LimitNOFILE:調高同時開啟的檔案數上限。一台 NAS 底下可能同時有
#     大量 Samba/NFS 連線各自開著檔案,systemd 的預設值(通常是 1024)
#     對這種用途來說偏低,調高不會有任何副作用。
#   - ProtectKernelLogs:擋存取核心 log ring buffer(dmesg 那份),
#     GoNAS 沒有任何功能需要讀核心 log。
#   - ProtectClock:擋修改系統時間/RTC,GoNAS 完全不需要動到時鐘。
#   - LockPersonality:擋切換執行環境(exec domain),沒有任何正常
#     操作需要這個系統呼叫。
#   - RestrictSUIDSGID:擋建立新的 setuid/setgid 檔案,GoNAS 本身跟它
#     呼叫的外部工具都不需要建立這種檔案,關掉能少一種提權管道。
#
# 刻意先不加的(留給 docs/REAL_HARDWARE_TESTING.md 的實機測試清單):
# ProtectSystem=、PrivateDevices=、ProtectKernelModules=、
# SystemCallFilter=、RestrictNamespaces= 這幾項會限制掛載檔案系統、
# 存取裝置節點(包含 mergerFS 用的 /dev/fuse)、系統呼叫白名單這些
# GoNAS 核心功能高度依賴的能力 —— systemd 的沙盒設定是套在整個
# process tree 上,gonasd 執行 mergerfs/snapraid 等子行程時也會繼承
# 同一組限制,錯誤的白名單/黑名單設定會讓陣列掛載或校驗行為以難以
# 預期的方式失敗,而這台開發沙盒沒有真實硬碟/mergerFS/SnapRAID 可以
# 實際驗證「加了這條會不會壞」,與其憑空猜測不如明確留白、等有真機
# 可以測的時候再一項一項加上去驗證。
LimitNOFILE=1048576
ProtectKernelLogs=true
ProtectClock=true
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
